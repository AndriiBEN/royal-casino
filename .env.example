# SQLite database file, relative to prisma/schema.prisma
DATABASE_URL="file:./casino.db"

# ---- Development-only admin seed (npm run db:seed:admin) ----
# Read only by prisma/seed-admin.ts on the server side. Never prefix these with NEXT_PUBLIC_.
# Leave ADMIN_PASSWORD empty to have a strong random password generated and printed once.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@royal.local"
ADMIN_PASSWORD=""

# Set to 1 only if you serve a production build over plain HTTP on a LAN address.
# INSECURE_COOKIES=1

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For. Without it the
# header is ignored, because clients can forge it to dodge the login and sign-up limits.
# TRUST_PROXY=1
